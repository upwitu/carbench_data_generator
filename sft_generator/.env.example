# =====================================================================
# CAR-Bench SFT Data Generator Environment Configuration (.env)
# =====================================================================

# 1. Hugging Face Authentication Token
# Required for pushing datasets to Hugging Face Hub
HF_TOKEN=your_huggingface_token_here
HF_DATASET_REPO=upwitu/carbench_sft_winner_dataset

# 2. LLM API Backend Configuration
#
# Option A: NVIDIA NIM API (Recommended - Fast & Free 1,000 Credits on build.nvidia.com)
#   Website: https://build.nvidia.com/deepseek-ai/deepseek-v4-flash-0731
#   OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
#   OPENAI_API_KEY=nvapi-your-key-here
#   (Optional multi-key rotation): NVIDIA_API_KEYS=nvapi-key1,nvapi-key2,nvapi-key3
#   CAR_BENCH_MODEL=deepseek-ai/deepseek-v4-flash-0731
#   (or deepseek-ai/deepseek-r1, deepseek-ai/deepseek-v3, meta/llama-3.3-70b-instruct)
#
# Option B: OpenRouter
#   OPENAI_API_BASE=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=sk-or-v1-...
#   CAR_BENCH_MODEL=google/gemma-2-27b-it
#
# Option C: Official DeepSeek API
#   OPENAI_API_BASE=https://api.deepseek.com/v1
#   OPENAI_API_KEY=sk-...
#   CAR_BENCH_MODEL=deepseek-chat

OPENAI_API_BASE=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=nvapi-your-nvidia-nim-key-here
CAR_BENCH_MODEL=deepseek-ai/deepseek-v4-flash-0731

# 3. Strict 40 RPM Rate Limiter & Concurrency Controls (NVIDIA NIM)
MAX_RPM=38
CONCURRENCY_LIMIT=8
REQUEST_DELAY_INTERVAL=1.5
MAX_RETRIES=8
RETRY_DELAY=3.0
MAX_BACKOFF_DELAY=60.0
VARIATIONS_PER_TASK=10
TEMPERATURE=0.7
TOP_P=0.95
REQUEST_TIMEOUT=120.0
